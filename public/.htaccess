<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Instagram Einstiegspunkt /portfolio → Startseite
  RewriteRule ^portfolio/?$ https://www.danielluzius.de/ [R=302,L]

  # Tracking-Parameter entfernen (utm, fbclid, igshid)
  RewriteCond %{QUERY_STRING} (utm_|fbclid|igshid) [NC]
  RewriteRule ^ %{REQUEST_URI}? [R=301,L]

  # Existing files and folders (JS, CSS, assets) stay as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Angular routes: /all-projects, /legal-notice, /privacy-policy
  RewriteRule ^ index.html [L]
</IfModule>
